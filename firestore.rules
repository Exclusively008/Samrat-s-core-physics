// Firestore Security Rules for Samrat Core Physics
// Deploy these rules in Firebase Console -> Firestore -> Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Students collection: Admin write, public read
    match /students/{studentId} {
      allow read: if true;  // Public read-only access
      allow write: if request.auth != null;  // Only authenticated admins
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Attendance collection: Admin write, public read
    match /attendance/{class} {
      allow read: if true;  // Public read-only access
      allow write: if request.auth != null;  // Only authenticated admins
      
      // Attendance subcollections per batch
      match /{batchId}/{document} {
        allow read: if true;  // Public read-only access
        allow write: if request.auth != null;  // Only authenticated admins
        allow create: if request.auth != null;
        allow update: if request.auth != null;
        allow delete: if request.auth != null;
      }
    }
    
    // Admin collection (if needed)
    match /admin/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default deny
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
